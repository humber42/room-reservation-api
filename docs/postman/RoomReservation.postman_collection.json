{
  "info": {
    "name": "Room Reservation API — pruebas locales",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Ejecutar en orden con Collection Runner, una iteración. La primera petición crea una sala única y fechas UTC para mañana. Captura IDs automáticamente. Las últimas peticiones cancelan las reservas; la sala y el historial permanecen porque la API no ofrece borrado físico. Usar una base local de pruebas. Las pruebas de carrera se ejecutan en la suite Java, no en este recorrido secuencial."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "admin",
      "type": "string"
    },
    {
      "key": "roomId",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomName",
      "value": "",
      "type": "string"
    },
    {
      "key": "roomNameUpper",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "adjacentBookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "replacementBookingId",
      "value": "",
      "type": "string"
    },
    {
      "key": "startAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "endAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "adjacentEndAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "preciseStartAt",
      "value": "",
      "type": "string"
    },
    {
      "key": "date",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 Crear sala y preparar ejecución",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/rooms",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{roomName}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const runId = pm.variables.replaceIn('{{$guid}}');",
              "pm.collectionVariables.set('roomName', 'Postman-' + runId);",
              "pm.collectionVariables.set('roomNameUpper', ('Postman-' + runId).toUpperCase());",
              "['roomId','bookingId','adjacentBookingId','replacementBookingId'].forEach(k => pm.collectionVariables.unset(k));",
              "const start = new Date(); start.setUTCDate(start.getUTCDate()+1); start.setUTCHours(10,0,0,0);",
              "pm.collectionVariables.set('date', start.toISOString().slice(0,10));",
              "pm.collectionVariables.set('startAt', start.toISOString());",
              "pm.collectionVariables.set('endAt', new Date(start.getTime()+3600000).toISOString());",
              "pm.collectionVariables.set('adjacentEndAt', new Date(start.getTime()+7200000).toISOString());",
              "pm.collectionVariables.set('preciseStartAt', start.toISOString().replace('.000Z','.000000001Z'));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "const room = pm.response.json(); pm.collectionVariables.set('roomId', String(room.id));",
              "pm.test('Sala creada y capacidad predeterminada', () => { pm.expect(room.name).to.eql(pm.collectionVariables.get('roomName')); pm.expect(room.capacity).to.eql(1); pm.expect(pm.response.headers.get('Location')).to.eql('/api/rooms/' + room.id); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar salas sin autenticación",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rooms",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Sala presente', () => pm.expect(pm.response.json().some(r => String(r.id) === pm.collectionVariables.get('roomId'))).to.be.true);"
            ]
          }
        }
      ]
    },
